[Unit]
Description=Zona ponente: sitio y sincronización
After=network.target

[Service]
Type=simple
User=ponente
Group=ponente
WorkingDirectory=/opt/zona-ponente
Environment=PORT=8110 HOST=127.0.0.1 DATA_DIR=/var/lib/zona-ponente
EnvironmentFile=/etc/zona-ponente/environment
ExecStart=/usr/bin/node server/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
StateDirectory=zona-ponente
StateDirectoryMode=0700
UMask=0077

[Install]
WantedBy=multi-user.target
